{
  "name": "@browser-ui/react",
  "version": "0.3.0",
  "description": "Composable browser UI for agent-browser pair-browsing and recordings.",
  "keywords": [
    "agent-browser",
    "browser",
    "react",
    "streaming",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/danielsims/browser-ui#readme",
  "bugs": {
    "url": "https://github.com/danielsims/browser-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsims/browser-ui.git",
    "directory": "packages/react"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter @browser-ui/core build && pnpm --filter @browser-ui/shaders build && tsup src/index.tsx --clean --format esm --dts --external react --external react-dom --external @browser-ui/core --external @browser-ui/shaders && node scripts/finalize-styles.mjs",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "prepack": "pnpm run build",
    "test": "pnpm --filter @browser-ui/core build && pnpm --filter @browser-ui/shaders build && vitest run",
    "typecheck": "pnpm --filter @browser-ui/core build && pnpm --filter @browser-ui/shaders build && tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@browser-ui/eslint-config": "workspace:*",
    "@browser-ui/prettier-config": "workspace:*",
    "@browser-ui/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "eslint": "catalog:",
    "jsdom": "^26.1.0",
    "prettier": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@browser-ui/core": "workspace:^",
    "@browser-ui/shaders": "workspace:^",
    "motion": "^12.42.2"
  },
  "prettier": "@browser-ui/prettier-config"
}
