{
  "name": "@browser-ui/expo-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@browser-ui/react-native": "workspace:*",
    "expo": "~55.0.24",
    "react": "^19.2.0",
    "react-native": "0.83.6"
  },
  "devDependencies": {
    "@browser-ui/eslint-config": "workspace:*",
    "@browser-ui/prettier-config": "workspace:*",
    "@browser-ui/tsconfig": "workspace:*",
    "@types/react": "~19.2.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@browser-ui/prettier-config"
}
