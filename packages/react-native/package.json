{
  "name": "@browser-ui/react-native",
  "version": "0.3.0",
  "description": "Native browser stream UI for agent-browser sessions.",
  "keywords": [
    "agent-browser",
    "expo",
    "react-native",
    "streaming"
  ],
  "license": "MIT",
  "homepage": "https://github.com/danielsims/browser-ui#readme",
  "bugs": {
    "url": "https://github.com/danielsims/browser-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsims/browser-ui.git",
    "directory": "packages/react-native"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --clean --format esm,cjs --dts --external react --external react-native --external react-native-webview --external expo-gl --external @browser-ui/core --external @browser-ui/shaders",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@browser-ui/core": "workspace:^",
    "@browser-ui/shaders": "workspace:^"
  },
  "peerDependencies": {
    "expo-gl": ">=13",
    "react": ">=18",
    "react-native": ">=0.81",
    "react-native-webview": ">=13"
  },
  "peerDependenciesMeta": {
    "expo-gl": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@browser-ui/eslint-config": "workspace:*",
    "@browser-ui/prettier-config": "workspace:*",
    "@browser-ui/tsconfig": "workspace:*",
    "@types/react": "^19.2.8",
    "eslint": "catalog:",
    "expo-gl": "~57.0.2",
    "prettier": "catalog:",
    "react": "^19.2.8",
    "react-native": "^0.83.6",
    "react-native-webview": "13.16.0",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  },
  "prettier": "@browser-ui/prettier-config"
}
