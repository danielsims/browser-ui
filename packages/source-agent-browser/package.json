{
  "name": "@browser-ui/source-agent-browser",
  "version": "0.2.0",
  "description": "Outbound source adapter from local agent-browser streams to Browser UI gateways.",
  "keywords": [
    "agent-browser",
    "browser",
    "gateway",
    "streaming"
  ],
  "license": "MIT",
  "homepage": "https://github.com/danielsims/browser-ui#readme",
  "bugs": {
    "url": "https://github.com/danielsims/browser-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsims/browser-ui.git",
    "directory": "packages/source-agent-browser"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "browser-ui-agent-browser-source": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @browser-ui/session build && tsup src/index.ts src/cli.ts --clean --format esm --dts",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@browser-ui/core": "workspace:*",
    "@browser-ui/session": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@browser-ui/gateway": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
