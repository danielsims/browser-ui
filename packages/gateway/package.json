{
  "name": "@browser-ui/gateway",
  "version": "0.2.0",
  "description": "Authenticated remote browser gateway with an agent-browser source connector.",
  "keywords": [
    "agent-browser",
    "browser",
    "gateway",
    "streaming"
  ],
  "license": "MIT",
  "homepage": "https://github.com/danielsims/browser-ui#readme",
  "bugs": {
    "url": "https://github.com/danielsims/browser-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsims/browser-ui.git",
    "directory": "packages/gateway"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-browser": {
      "types": "./dist/agent-browser/index.d.ts",
      "import": "./dist/agent-browser/index.js"
    }
  },
  "bin": {
    "browser-ui-agent-browser-source": "./dist/agent-browser/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/agent-browser/index.ts src/agent-browser/cli.ts --clean --format esm --dts",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@browser-ui/core": "workspace:^",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@browser-ui/eslint-config": "workspace:*",
    "@browser-ui/prettier-config": "workspace:*",
    "@browser-ui/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  },
  "prettier": "@browser-ui/prettier-config"
}
