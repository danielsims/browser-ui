{
  "name": "@browser-ui/react",
  "version": "0.1.1",
  "description": "A composable, transport-agnostic browser surface for React.",
  "keywords": [
    "agent-browser",
    "browser",
    "react",
    "streaming",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/danielsims/browser-ui#readme",
  "bugs": {
    "url": "https://github.com/danielsims/browser-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsims/browser-ui.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./src/*.css",
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.tsx --clean --format esm,cjs --dts --external react --external react-dom --loader .css=copy && node scripts/finalize-styles.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "motion": "^12.42.2"
  }
}
