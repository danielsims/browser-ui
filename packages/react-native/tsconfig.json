{
  "extends": "@browser-ui/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@browser-ui/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src"]
}
